---
/**
 * Portrait film loops. Videos load only when near the viewport (preload="none"),
 * play muted while visible, pause when off-screen, and never autoplay with reduced motion.
 * Every clip has a visible pause/play control (WCAG 2.2.2).
 */
import Icon from './Icon.astro';
import { FILMS } from '@/content/media';
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/routes';

type FilmKey = keyof typeof FILMS;
interface Props {
  lang: Locale;
  films: FilmKey[];
}
const { lang, films } = Astro.props;
const s = t(lang);
---

<div class:list={['reel', `reel--${films.length}`]} data-reel>
  {
    films.map((key, i) => {
      const f = FILMS[key];
      return (
        <figure class="reel-item" data-reveal style={`--reveal-delay:${i * 0.12}s`}>
          <div class="reel-frame">
            <video
              class="reel-video"
              muted
              loop
              playsinline
              preload="none"
              poster={f.poster}
              width="576"
              height="1024"
              data-src={f.src}
              aria-label={f.caption[lang]}
            />
            <button type="button" class="reel-toggle" data-reel-toggle aria-pressed="false" data-label-play={s.video.play} data-label-pause={s.video.pause}>
              <span class="visually-hidden" data-reel-label>{s.video.play}</span>
              <span class="reel-ic reel-ic--play"><Icon name="play" size={14} /></span>
              <span class="reel-ic reel-ic--pause"><Icon name="pause" size={14} /></span>
            </button>
          </div>
        </figure>
      );
    })
  }
</div>

<style>
  .reel {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
  }
  .reel--2 {
    --cols: 2;
  }
  .reel--3 .reel-item:nth-child(2) {
    margin-top: clamp(3rem, 9vw, 9rem);
  }
  .reel--3 .reel-item:nth-child(3) {
    margin-top: clamp(1.5rem, 4.5vw, 4.5rem);
  }
  .reel--2 .reel-item:nth-child(2) {
    margin-top: clamp(3rem, 8vw, 8rem);
  }
  .reel-frame {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--navy-dark);
  }
  .reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel-toggle {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(8, 14, 23, 0.55);
    color: var(--ivory);
    border: 1px solid rgba(242, 238, 228, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background-color 0.3s var(--ease);
  }
  .reel-toggle:hover {
    background: rgba(8, 14, 23, 0.8);
  }
  .reel-ic {
    position: absolute;
    display: grid;
    place-items: center;
  }
  .reel-ic--pause,
  .reel-toggle[aria-pressed='true'] .reel-ic--play {
    display: none;
  }
  .reel-toggle[aria-pressed='true'] .reel-ic--pause {
    display: grid;
  }
  .reel-caption {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .reel-caption span {
    color: var(--bronze);
  }
  :global(.section--dark) .reel-caption span {
    color: var(--gold);
  }

  @media (max-width: 760px) {
    .reel {
      display: flex;
      gap: 1rem;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .reel::-webkit-scrollbar {
      display: none;
    }
    .reel-item {
      flex: 0 0 68%;
      scroll-snap-align: center;
      margin-top: 0 !important;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    reel.querySelectorAll<HTMLElement>('.reel-frame').forEach((frame) => {
      const video = frame.querySelector('video')!;
      const btn = frame.querySelector<HTMLButtonElement>('[data-reel-toggle]')!;
      const label = btn.querySelector<HTMLElement>('[data-reel-label]')!;
      let userPaused = reduce; // reduced motion: never start automatically
      let loaded = false;

      const load = () => {
        if (loaded) return;
        video.src = video.dataset.src!;
        loaded = true;
      };
      const sync = () => {
        const playing = !video.paused;
        btn.setAttribute('aria-pressed', String(playing));
        label.textContent = playing ? btn.dataset.labelPause! : btn.dataset.labelPlay!;
      };
      const play = () => {
        load();
        video.play().catch(() => {}).finally(sync);
      };
      video.addEventListener('play', sync);
      video.addEventListener('pause', sync);

      btn.addEventListener('click', () => {
        if (video.paused) {
          userPaused = false;
          play();
        } else {
          userPaused = true;
          video.pause();
        }
      });

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              if (!userPaused) play();
            } else if (!video.paused) {
              video.pause();
            }
          },
          { rootMargin: '150px 0px', threshold: 0.25 },
        ).observe(frame);
      }
    });
  });
</script>
