---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo.png';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { url, type Locale, type RouteKey } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { SERVICE_LIST } from '@/content/services';
import { CONTACT, LINKS } from '@/config/site';

interface Props {
  lang: Locale;
  route?: RouteKey;
  /** Transparent over a full-bleed hero, turning solid on scroll. */
  transparent?: boolean;
}
const { lang, route, transparent = false } = Astro.props;
const s = t(lang);
const serviceRoutes: RouteKey[] = ['services', ...SERVICE_LIST.map((x) => x.route)];
const isServices = route ? serviceRoutes.includes(route) : false;
---

<header class="site-header" data-transparent={transparent ? '' : undefined} data-header>
  <div class="container header-inner">
    <a class="brand" href={url('home', lang)} aria-label={`DOVERO GROUP — ${s.nav.home}`}>
      <Image src={logo} alt="DOVERO GROUP" width={190} densities={[1, 2]} loading="eager" class="brand-logo" />
    </a>

    <nav class="primary-nav" aria-label={s.nav.mainLabel}>
      <ul role="list">
        <li><a href={url('home', lang)} aria-current={route === 'home' ? 'page' : undefined}>{s.nav.home}</a></li>
        <li class="has-dropdown" data-dropdown>
          <button type="button" class="nav-trigger" aria-expanded="false" aria-controls="services-menu" data-dropdown-trigger aria-current={isServices ? 'true' : undefined}>
            {s.nav.services}
            <Icon name="chevron" size={14} />
          </button>
          <div class="dropdown" id="services-menu" data-dropdown-panel>
            <ul role="list" class="dropdown-list">
              {
                SERVICE_LIST.map((svc) => (
                  <li>
                    <a href={url(svc.route, lang)} aria-current={route === svc.route ? 'page' : undefined}>
                      <span class="dd-num">{svc.number}</span>
                      <span class="dd-name">{svc.name[lang]}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="dropdown-all link-arrow" href={url('services', lang)}>
              {s.nav.allServices}
              <Icon name="arrow" size={10} />
            </a>
          </div>
        </li>
        <li><a href={url('about', lang)} aria-current={route === 'about' ? 'page' : undefined}>{s.nav.about}</a></li>
        <li><a href={url('contact', lang)} aria-current={route === 'contact' ? 'page' : undefined}>{s.nav.contact}</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <LanguageSwitcher lang={lang} route={route} class="header-lang" />
      <a class="btn btn--ghost header-cta" href={url('contact', lang, 'inquiry')} data-track="quote_request" data-track-label="header">
        <Icon name="calendar" size={18} />
        {s.cta.quote}
      </a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="menu-toggle-label">{s.nav.menu}</span>
        <Icon name="menu" size={14} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="mobile-menu-inner container">
      <div class="mobile-menu-top">
        <LanguageSwitcher lang={lang} route={route} />
        <button type="button" class="menu-close" data-menu-close>
          <span>{s.nav.close}</span>
          <Icon name="close" size={22} />
        </button>
      </div>
      <nav aria-label={s.nav.mainLabel}>
        <ul role="list" class="mobile-nav">
          <li><a href={url('home', lang)} aria-current={route === 'home' ? 'page' : undefined}>{s.nav.home}</a></li>
          <li>
            <a href={url('services', lang)} aria-current={route === 'services' ? 'page' : undefined}>{s.nav.services}</a>
            <ul role="list" class="mobile-subnav">
              {
                SERVICE_LIST.map((svc) => (
                  <li>
                    <a href={url(svc.route, lang)} aria-current={route === svc.route ? 'page' : undefined}>
                      <span>{svc.number}</span> {svc.name[lang]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
          <li><a href={url('about', lang)} aria-current={route === 'about' ? 'page' : undefined}>{s.nav.about}</a></li>
          <li><a href={url('contact', lang)} aria-current={route === 'contact' ? 'page' : undefined}>{s.nav.contact}</a></li>
        </ul>
      </nav>
      <div class="mobile-menu-contact">
        <a class="btn btn--block" href={url('contact', lang, 'inquiry')} data-track="quote_request" data-track-label="mobile_menu">{s.cta.quote}<Icon name="arrow" size={10} /></a>
        <div class="mobile-quick">
          <a href={LINKS.whatsapp} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-label="mobile_menu"><Icon name="whatsapp" size={18} />WhatsApp</a>
          <a href={LINKS.viber} data-track="viber_click" data-track-label="mobile_menu"><Icon name="viber" size={18} />Viber</a>
          <a href={LINKS.tel} data-track="phone_click" data-track-label="mobile_menu"><Icon name="phone" size={18} />{s.cta.call}</a>
        </div>
        <p class="mobile-phone">{CONTACT.phoneDisplay}</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--on-dark);
    background: rgba(5, 10, 18, 0.96);
    border-bottom: 1px solid var(--line-dark);
    transition:
      background-color 0.5s var(--ease),
      border-color 0.5s var(--ease),
      transform 0.5s var(--ease-out);
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      background: rgba(5, 10, 18, 0.82);
      backdrop-filter: blur(14px) saturate(1.2);
      -webkit-backdrop-filter: blur(14px) saturate(1.2);
    }
  }
  .site-header[data-transparent]:not(.is-solid) {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header[data-transparent]:not(.is-solid)::before {
    content: '';
    position: absolute;
    inset: 0 0 -40px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(4, 9, 16, 0.55), transparent);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: var(--header-h);
  }
  .brand {
    display: block;
    flex: none;
    align-self: flex-start;
    padding-top: 0.6rem;
  }
  .brand :global(.brand-logo) {
    width: auto;
    height: calc(var(--header-h) - 20px);
    transition: height 0.5s var(--ease);
  }
  /* Over the home hero the logo is presented large, as in the brand mockup */
  @media (min-width: 961px) {
    .site-header[data-transparent]:not(.is-solid) .brand :global(.brand-logo) {
      height: 116px;
    }
  }

  /* Desktop nav */
  .primary-nav > ul {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .primary-nav a,
  .nav-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-block: 0.75rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
  }
  .primary-nav > ul > li > a::after,
  .nav-trigger::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }
  .primary-nav > ul > li > a[aria-current='page'],
  .nav-trigger[aria-current='true'] {
    color: var(--gold);
  }
  .primary-nav > ul > li > a:hover::after,
  .primary-nav > ul > li > a[aria-current='page']::after,
  .nav-trigger[aria-current='true']::after,
  .has-dropdown:hover .nav-trigger::after {
    transform: scaleX(1);
  }
  .nav-trigger :global(svg) {
    transition: transform 0.3s var(--ease);
  }
  .nav-trigger[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .has-dropdown {
    position: relative;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: -2rem;
    width: 25rem;
    padding: 1.25rem 2rem 1.75rem;
    background: rgba(8, 14, 23, 0.97);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.4s var(--ease-out),
      visibility 0s linear 0.3s;
  }
  .dropdown::before {
    /* hover bridge */
    content: '';
    position: absolute;
    inset: -1rem 0 auto;
    height: 1rem;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown,
  .has-dropdown.is-open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .has-dropdown.is-closed .dropdown {
    opacity: 0;
    visibility: hidden;
  }
  .dropdown-list {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .dropdown-list a {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    width: 100%;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line-dark);
    letter-spacing: 0;
    text-transform: none;
    transition:
      color 0.3s var(--ease),
      padding 0.4s var(--ease-out);
  }
  .dropdown-list a:hover,
  .dropdown-list a[aria-current='page'] {
    color: var(--gold);
    padding-left: 0.4rem;
  }
  .dd-num {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--gold);
  }
  .dd-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.2;
  }
  .dropdown-all {
    color: var(--gold) !important;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .header-cta {
    min-height: 2.9rem;
    padding: 0.65rem 1.4rem;
    font-size: 0.72rem;
    gap: 0.65rem;
  }
  .menu-toggle,
  .menu-close {
    display: none;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.5rem 0;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 110;
    background: var(--navy-dark);
    color: var(--on-dark);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .mobile-menu.is-open {
    opacity: 1;
  }
  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: 0.5rem 2rem;
  }
  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }
  .menu-close {
    display: inline-flex;
  }
  .mobile-nav {
    margin: 1.5rem 0 2.5rem;
    padding: 0;
    list-style: none;
  }
  .mobile-nav > li {
    border-bottom: 1px solid var(--line-dark);
  }
  .mobile-nav > li > a {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 8vw, 2.75rem);
    line-height: 1.1;
  }
  .mobile-nav a[aria-current='page'] {
    color: var(--gold);
  }
  .mobile-subnav {
    margin: -0.25rem 0 1rem;
    padding: 0;
    list-style: none;
  }
  .mobile-subnav a {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }
  .mobile-subnav a span {
    display: inline-block;
    width: 2rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--gold);
  }
  .mobile-menu-contact {
    margin-top: auto;
  }
  .mobile-quick {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 0.75rem;
    border: 1px solid var(--line-dark);
  }
  .mobile-quick a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.9rem 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .mobile-quick a + a {
    border-left: 1px solid var(--line-dark);
  }
  .mobile-quick :global(svg) {
    color: var(--gold);
  }
  .mobile-phone {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--on-dark-soft);
  }

  @media (min-width: 961px) {
    .site-header.is-solid .brand :global(.brand-logo) {
      height: calc(var(--header-h) - 30px);
    }
  }

  @media (max-width: 1100px) {
    .header-cta {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .primary-nav,
    .header-lang {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
    .brand :global(.brand-logo) {
      height: calc(var(--header-h) - 16px);
    }
  }
</style>

<script>
  import '@/scripts/header';
</script>
