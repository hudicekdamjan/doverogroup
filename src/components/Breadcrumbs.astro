---
import { url, type Locale, type RouteKey } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  lang: Locale;
  items: { name: string; route: RouteKey }[];
}
const { lang, items } = Astro.props;
const s = t(lang);
---

<nav class="breadcrumbs" aria-label={s.nav.breadcrumb}>
  <ol role="list">
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={url(item.route, lang)}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.7rem;
    font-weight: 450;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .breadcrumbs li + li::before {
    content: '/';
    margin-inline: 0.75rem;
    opacity: 0.45;
  }
  .breadcrumbs a {
    opacity: 0.75;
    transition: opacity 0.3s var(--ease);
  }
  .breadcrumbs a:hover {
    opacity: 1;
  }
  .breadcrumbs [aria-current] {
    color: var(--gold);
  }
</style>
