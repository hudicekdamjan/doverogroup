---
/** Before/after comparison slider. Keyboard accessible via a native range input. */
import { Image } from 'astro:assets';
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/routes';
import type { BeforeAfterItem } from '@/content/gallery';

interface Props {
  pair: BeforeAfterItem;
  lang: Locale;
}
const { pair, lang } = Astro.props;
const s = t(lang);
---

<figure class="ba" data-ba style="--pos: 50%">
  <div class="ba-frame">
    <Image src={pair.after} alt={`${s.gallery.after}: ${pair.alt[lang]}`} widths={[640, 1080, 1600]} sizes="(max-width: 900px) 92vw, 80vw" class="ba-img" />
    <div class="ba-before">
      <Image src={pair.before} alt={`${s.gallery.before}: ${pair.alt[lang]}`} widths={[640, 1080, 1600]} sizes="(max-width: 900px) 92vw, 80vw" class="ba-img" />
    </div>
    <span class="ba-tag ba-tag--before">{s.gallery.before}</span>
    <span class="ba-tag ba-tag--after">{s.gallery.after}</span>
    <span class="ba-handle" aria-hidden="true"></span>
    <input class="ba-range" type="range" min="0" max="100" value="50" aria-label={`${s.gallery.before} / ${s.gallery.after}`} />
  </div>
</figure>

<style>
  .ba-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy-dark);
  }
  .ba-frame :global(.ba-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 1px;
    background: var(--surface);
    pointer-events: none;
  }
  .ba-handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--ivory);
    background: rgba(8, 14, 23, 0.55);
    transform: translate(-50%, -50%);
  }
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ba-tag {
    position: absolute;
    top: 1rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: rgba(8, 14, 23, 0.6);
    color: var(--ivory);
  }
  .ba-tag--before {
    left: 1rem;
  }
  .ba-tag--after {
    right: 1rem;
  }
  .ba-caption {
    margin-top: 0.75rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.ba-range')!;
    range.addEventListener('input', () => el.style.setProperty('--pos', `${range.value}%`));
  });
</script>
