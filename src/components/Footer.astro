---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo.png';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { url, type Locale, type RouteKey } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { SERVICE_LIST } from '@/content/services';
import { CONTACT, CONTACT_EMAIL, LINKS, SERVICE_AREAS, SOCIAL, REGION } from '@/config/site';

interface Props {
  lang: Locale;
  route?: RouteKey;
}
const { lang, route } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <!-- Contact bar (as in the brand mockup). The email slot appears only once CONTACT_EMAIL is configured. -->
  <div class="contact-bar">
    <div class="container cb-inner">
      <p class="cb-item"><Icon name="pin" size={24} /><span>{REGION[lang]}</span></p>
      <a class="cb-item" href={LINKS.tel} data-track="phone_click" data-track-label="contact_bar"><Icon name="phone" size={24} /><span>{CONTACT.phoneDisplay}</span></a>
      {
        CONTACT_EMAIL ? (
          <a class="cb-item" href={LINKS.email} data-track="email_click" data-track-label="contact_bar">
            <Icon name="mail" size={24} />
            <span>{CONTACT_EMAIL}</span>
          </a>
        ) : (
          <p class="cb-item cb-msg">
            <a href={LINKS.whatsapp} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-label="contact_bar">
              <Icon name="whatsapp" size={22} />
              <span>WhatsApp</span>
            </a>
            <a href={LINKS.viber} data-track="viber_click" data-track-label="contact_bar">
              <Icon name="viber" size={22} />
              <span>Viber</span>
            </a>
          </p>
        )
      }
      <a class="btn cb-btn" href={url('contact', lang, 'inquiry')} data-track="quote_request" data-track-label="contact_bar">
        {lang === 'en' ? 'Get a quote' : 'Zatražite ponudu'}
        <Icon name="arrow" size={10} />
      </a>
    </div>
  </div>

  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={url('home', lang)} aria-label={`DOVERO GROUP — ${s.nav.home}`}>
          <Image src={logo} alt="DOVERO GROUP" width={170} densities={[1, 2]} class="footer-logo" />
        </a>
        <p class="footer-tagline">{s.footer.tagline}</p>
      </div>

      <div class="footer-cols">
        <div>
          <h2 class="footer-h">{s.footer.services}</h2>
          <ul role="list">
            {SERVICE_LIST.map((svc) => <li><a href={url(svc.route, lang)}>{svc.name[lang]}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="footer-h">{s.footer.company}</h2>
          <ul role="list">
            <li><a href={url('home', lang)}>{s.nav.home}</a></li>
            <li><a href={url('services', lang)}>{s.nav.allServices}</a></li>
            <li><a href={url('about', lang)}>{s.nav.about}</a></li>
            <li><a href={url('contact', lang)}>{s.nav.contact}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-h">{s.footer.contact}</h2>
          <ul role="list" class="footer-contact">
            <li><a href={LINKS.tel} data-track="phone_click" data-track-label="footer"><Icon name="phone" size={16} />{CONTACT.phoneDisplay}</a></li>
            <li><a href={LINKS.whatsapp} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-label="footer"><Icon name="whatsapp" size={16} />WhatsApp</a></li>
            <li><a href={LINKS.viber} data-track="viber_click" data-track-label="footer"><Icon name="viber" size={16} />Viber</a></li>
            {CONTACT_EMAIL && <li><a href={LINKS.email} data-track="email_click" data-track-label="footer"><Icon name="mail" size={16} />{CONTACT_EMAIL}</a></li>}
          </ul>
        </div>
        <div>
          <h2 class="footer-h">{s.footer.areas}</h2>
          <ul role="list" class="footer-areas">
            {SERVICE_AREAS.map((a) => <li>{a.name}{a.detail && <span> · {a.detail}</span>}</li>)}
          </ul>
          <p class="footer-region"><Icon name="pin" size={15} />{REGION[lang]}</p>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} DOVERO GROUP. {s.footer.rights}</p>
      {
        SOCIAL.length > 0 && (
          <ul role="list" class="footer-social">
            {SOCIAL.map((so) => <li><a href={so.url} target="_blank" rel="noopener">{so.label}</a></li>)}
          </ul>
        )
      }
      <LanguageSwitcher lang={lang} route={route} />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: var(--on-dark);
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }
  .contact-bar {
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
    background: #070d16;
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }
  .cb-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    min-height: 6rem;
    padding-block: 1.1rem;
  }
  .cb-item {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.95rem;
    color: rgba(242, 238, 228, 0.92);
  }
  .cb-item :global(svg) {
    color: var(--gold);
  }
  .cb-msg {
    gap: 1.75rem;
  }
  .cb-msg a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: color 0.3s var(--ease);
  }
  a.cb-item:hover,
  .cb-msg a:hover {
    color: var(--gold-soft);
  }
  .cb-btn {
    min-width: 12.5rem;
  }
  .footer-top {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 2fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }
  .footer-brand :global(.footer-logo) {
    width: 170px;
    height: auto;
  }
  .footer-tagline {
    margin-top: 1.75rem;
    max-width: 22rem;
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }
  .footer-h {
    margin-bottom: 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gold);
  }
  .footer-cols ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
    font-size: 0.92rem;
  }
  .footer-cols a {
    color: var(--on-dark-soft);
    transition: color 0.3s var(--ease);
  }
  .footer-cols a:hover {
    color: var(--gold-soft);
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .footer-contact :global(svg) {
    color: var(--gold);
  }
  .footer-areas {
    color: var(--on-dark-soft);
  }
  .footer-areas span {
    opacity: 0.7;
  }
  .footer-region {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--on-dark-soft);
  }
  .footer-region :global(svg) {
    color: var(--gold);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.8rem;
    color: var(--on-dark-soft);
  }
  .footer-social {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 1100px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 900px) {
    .cb-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding-block: 1.75rem;
    }
    .cb-btn {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 2.25rem 1.5rem;
    }
    .footer-bottom {
      padding-right: 4.5rem; /* keep clear of the floating contact button */
    }
  }
  @media (max-width: 520px) {
    .cb-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
