---
/** Editorial gallery + accessible lightbox (<dialog>): keyboard, swipe, focus return. */
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import BeforeAfter from './BeforeAfter.astro';
import { GALLERY, BEFORE_AFTER, GALLERY_CATEGORIES, type GalleryCategory } from '@/content/gallery';
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/routes';

interface Props {
  lang: Locale;
  limit?: number;
}
const { lang, limit } = Astro.props;
const s = t(lang);
const items = typeof limit === 'number' ? GALLERY.slice(0, limit) : GALLERY;

const large = await Promise.all(
  items.map(async (item) => {
    const img = await getImage({ src: item.src, width: Math.min(item.src.width, 2000), format: 'webp', quality: 78 });
    return img.src;
  }),
);

// Filters appear only when there is something meaningful to filter.
const counts = items.reduce<Record<string, number>>((acc, i) => ((acc[i.category] = (acc[i.category] ?? 0) + 1), acc), {});
const cats = (Object.keys(counts) as GalleryCategory[]).filter((c) => counts[c] >= 2);
const showFilters = cats.length >= 2;
---

<div class="gallery" data-gallery>
  {
    showFilters && (
      <div class="g-filters" role="group" aria-label={s.gallery.label}>
        <button type="button" class="g-filter" aria-pressed="true" data-filter="all">{s.gallery.all}</button>
        {cats.map((c) => (
          <button type="button" class="g-filter" aria-pressed="false" data-filter={c}>
            {GALLERY_CATEGORIES[c][lang]}
          </button>
        ))}
      </div>
    )
  }

  <ul role="list" class="g-grid">
    {
      items.map((item, i) => (
        <li class:list={['g-item', `g-item--${item.size}`]} data-category={item.category} data-reveal="mask" style={`--reveal-delay:${(i % 3) * 0.08}s`}>
          <button type="button" class="g-open" data-index={i} data-full={large[i]} data-alt={item.alt[lang]}>
            <Picture
              src={item.src}
              alt={item.alt[lang]}
              widths={[480, 720, 1080].filter((w) => w <= item.src.width)}
              sizes={item.size === 'wide' ? '(max-width: 760px) 92vw, 60vw' : '(max-width: 760px) 92vw, 30vw'}
              formats={['avif', 'webp']}
              quality={68}
              loading="lazy"
              class="cover g-img"
              style={`object-position:${item.focus ?? '50% 50%'}`}
            />
            <span class="g-meta">
              <span class="g-plus">
                <Icon name="plus" size={18} />
                <span class="visually-hidden">{s.gallery.open}: {item.alt[lang]}</span>
              </span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  {BEFORE_AFTER.length > 0 && (
    <div class="g-ba">
      {BEFORE_AFTER.map((pair) => <BeforeAfter pair={pair} lang={lang} />)}
    </div>
  )}

  <dialog class="lightbox" data-lightbox aria-label={s.gallery.label}>
    <figure class="lb-figure">
      <img class="lb-img" data-lb-img alt="" decoding="async" />
      <figcaption class="lb-caption">
        <span class="lb-count" data-lb-count></span>
      </figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" data-lb-close><Icon name="close" size={24} /><span class="visually-hidden">{s.gallery.close}</span></button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev><Icon name="prev" size={30} /><span class="visually-hidden">{s.gallery.prev}</span></button>
    <button type="button" class="lb-btn lb-next" data-lb-next><Icon name="next" size={30} /><span class="visually-hidden">{s.gallery.next}</span></button>
  </dialog>
</div>

<style>
  .g-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-bottom: 2.5rem;
  }
  .g-filter {
    padding: 0.5rem 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid transparent;
    transition:
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .g-filter[aria-pressed='true'],
  .g-filter:hover {
    color: var(--ink);
    border-bottom-color: var(--gold);
  }
  .g-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: clamp(9rem, 14vw, 13.5rem);
    grid-auto-flow: dense;
    gap: clamp(0.6rem, 1.2vw, 1.1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .g-item {
    position: relative;
    grid-column: span 2;
    grid-row: span 2;
  }
  .g-item--wide {
    grid-column: span 4;
    grid-row: span 3;
  }
  .g-item--tall {
    grid-column: span 2;
    grid-row: span 3;
  }
  .g-item--square {
    grid-column: span 2;
    grid-row: span 2;
  }
  .g-item[hidden] {
    display: none;
  }
  .g-open {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--navy-dark);
    cursor: zoom-in;
  }
  .g-open :global(.g-img) {
    position: absolute;
    inset: 0;
    transition: transform 1.2s var(--ease-out);
  }
  .g-open:hover :global(.g-img) {
    transform: scale(1.04);
  }
  .g-meta {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 2.5rem 1.1rem 1rem;
    background: linear-gradient(to top, rgba(5, 10, 18, 0.7), transparent);
    color: var(--ivory);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .g-open:hover .g-meta,
  .g-open:focus-visible .g-meta {
    opacity: 1;
  }
  .g-cat {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .g-plus {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(242, 238, 228, 0.5);
    border-radius: 50%;
  }
  .g-ba {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(3, 7, 13, 0.97);
    color: var(--ivory);
  }
  .lightbox::backdrop {
    background: rgba(3, 7, 13, 0.9);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.35s var(--ease);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: min(92vw, 1600px);
  }
  .lb-img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lb-caption {
    display: flex;
    gap: 2rem;
    justify-content: flex-end;
    width: 100%;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--on-dark-soft);
  }
  .lb-count {
    flex: none;
    letter-spacing: 0.15em;
    color: var(--gold);
  }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    color: var(--ivory);
    opacity: 0.8;
    transition: opacity 0.3s var(--ease);
  }
  .lb-btn:hover {
    opacity: 1;
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 1rem;
  }
  .lb-next {
    right: 1rem;
  }

  @media (max-width: 760px) {
    .g-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 42vw;
    }
    .g-item,
    .g-item--square {
      grid-column: span 1;
      grid-row: span 1;
    }
    .g-item--tall {
      grid-column: span 1;
      grid-row: span 2;
    }
    .g-item--wide {
      grid-column: span 2;
      grid-row: span 1;
    }
    .g-meta {
      opacity: 1;
      background: none;
      padding: 0.6rem;
      justify-content: flex-end;
    }
    .g-cat {
      display: none;
    }
    .g-plus {
      width: 1.9rem;
      height: 1.9rem;
      background: rgba(5, 10, 18, 0.45);
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 0.75rem;
      transform: none;
    }
    .lb-img {
      max-height: calc(100dvh - 10rem);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const allButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.g-open'));
    let visible = allButtons;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + visible.length) % visible.length;
      const b = visible[index];
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt!;
      count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(visible.length).padStart(2, '0')}`;
      // Preload neighbours for instant navigation
      [index + 1, index - 1].forEach((n) => {
        const nb = visible[(n + visible.length) % visible.length];
        if (nb) new Image().src = nb.dataset.full!;
      });
    };

    allButtons.forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        show(visible.indexOf(b));
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );

    // Filters
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter!;
        root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        root.querySelectorAll<HTMLElement>('.g-item').forEach((li) => {
          li.hidden = f !== 'all' && li.dataset.category !== f;
          li.classList.add('is-visible');
        });
        visible = allButtons.filter((b) => !(b.closest('.g-item') as HTMLElement).hidden);
      }),
    );
  });
</script>
